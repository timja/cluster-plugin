<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2236.v12dd4c483242</version>
    <relativePath />
  </parent>
  <groupId>io.jenkins.plugins.cnj</groupId>
  <artifactId>persistence-store-postgresql</artifactId>
  <version>${changelist}</version>
  <packaging>hpi</packaging>
  <name>Persistence Store: PostgreSQL</name>
  <description>Stores item configuration and build records in PostgreSQL, and build snapshots and Pipeline logs in Azure Blob Storage, so several controllers can share them (cloud-native Jenkins).</description>
  <properties>
    <changelist>999999-SNAPSHOT</changelist>
    <!-- Needs the jenkins.persistence SPI from the cnj/t1-* core branches, installed locally. -->
    <jenkins.version>2.586-SNAPSHOT</jenkins.version>
    <useBeta>true</useBeta>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <spotbugs.failOnError>false</spotbugs.failOnError>
  </properties>
  <dependencyManagement>
    <dependencies>
      <!-- upper bounds required by scm-api (via workflow-api); test classpath only, not plugin dependencies -->
      <dependency>
        <groupId>io.jenkins.plugins</groupId>
        <artifactId>asm-api</artifactId>
        <version>9.9-185.va_6c6b_3348b_c3</version>
      </dependency>
      <dependency>
        <groupId>io.jenkins.plugins</groupId>
        <artifactId>caffeine-api</artifactId>
        <version>3.2.2-178.v353b_8428ed56</version>
      </dependency>
      <dependency>
        <groupId>org.jenkins-ci.plugins</groupId>
        <artifactId>scm-api</artifactId>
        <version>728.vc30dcf7a_0df5</version>
      </dependency>
      <dependency>
        <groupId>org.jenkins-ci.plugins</groupId>
        <artifactId>structs</artifactId>
        <version>362.va_b_695ef4fdf9</version>
      </dependency>
      <!-- required by workflow-cps / workflow-support; the harness image has these or newer -->
      <dependency>
        <groupId>org.jenkins-ci.plugins.workflow</groupId>
        <artifactId>workflow-step-api</artifactId>
        <version>724.v538c2362b_dfb_</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <!-- Azure Blob Storage client (the harness uses Azurite) -->
      <groupId>io.jenkins.plugins</groupId>
      <artifactId>azure-sdk</artifactId>
      <version>292.v2db_0b_b_b_50d35</version>
    </dependency>
    <dependency>
      <!-- MilestoneStorage, for milestone across controllers -->
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>pipeline-milestone-step</artifactId>
      <version>152.v6e22b_8cfc66c</version>
    </dependency>
    <dependency>
      <!-- LogStorageFactory, for Pipeline logs in blob storage -->
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-api</artifactId>
      <version>1413.v2ff1a_5e720fa_</version>
    </dependency>
    <dependency>
      <!-- ProgramSavedListener, from the cnj/t4-m1-program-saved-listener branch, installed locally -->
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-cps</artifactId>
      <version>999999-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.8</version>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>1.21.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>1.21.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Target 9: cluster-wide cloud agent caps (kubernetes-plugin cnj/t9-m2-cluster-cap, installed locally) -->
      <groupId>org.csanchez.jenkins.plugins</groupId>
      <artifactId>kubernetes</artifactId>
      <version>999999-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
