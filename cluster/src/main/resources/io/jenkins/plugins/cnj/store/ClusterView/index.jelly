<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="${it.displayName}" permission="${app.SYSTEM_READ}" type="one-column">
    <l:main-panel>
      <l:app-bar title="${it.displayName}"/>
      <p>This page is served by <strong>${it.self}</strong>. Everything below comes from the persistence store. See also <a href="compatibility/">what this controller keeps that the cluster does not share</a>.</p>
      <h2>Controllers</h2>
      <table class="jenkins-table">
        <thead><tr><th>Name</th><th>Internal URL</th><th>Started</th><th>Last heartbeat</th><th>Alive</th><th>Version</th></tr></thead>
        <tbody>
          <j:forEach var="m" items="${it.members}">
            <tr>
              <td>${m.name}</td><td>${m.url}</td>
              <td>${h.getTimeSpanString(m.started)} ago</td><td>${h.getTimeSpanString(m.heartbeat)} ago</td>
              <td>${m.alive ? 'yes' : 'no'}</td><td>${m.version} (protocol ${m.protocol})</td>
            </tr>
          </j:forEach>
        </tbody>
      </table>
      <h2>Running builds</h2>
      <table class="jenkins-table">
        <thead><tr><th>Build</th><th>Running on</th></tr></thead>
        <tbody>
          <j:forEach var="b" items="${it.runningBuilds}">
            <tr><td>${b.job} #${b.number}</td><td>${b.controller}</td></tr>
          </j:forEach>
        </tbody>
      </table>
      <h2>Agent channels</h2>
      <table class="jenkins-table">
        <thead><tr><th>Agent</th><th>Connected to</th></tr></thead>
        <tbody>
          <j:forEach var="c" items="${it.channels}">
            <tr><td>${c.agent}</td><td>${c.controller}</td></tr>
          </j:forEach>
        </tbody>
      </table>
    </l:main-panel>
  </l:layout>
</j:jelly>
