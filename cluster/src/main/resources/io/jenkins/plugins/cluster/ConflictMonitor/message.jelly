<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core">
  <div class="jenkins-alert jenkins-alert-warning">
    <p>Controllers of this cluster saved the same setting at the same moment. The later save was refused, not written
      over the other: the stored version stands, and the refused change has to be made again. Changes to different
      settings were merged.</p>
    <table class="jenkins-table jenkins-table--small">
      <thead><tr><th>Controller</th><th>Merged</th><th>Refused</th></tr></thead>
      <tbody>
        <j:forEach var="c" items="${it.counts}">
          <tr><td>${c.controller()}</td><td>${c.merged()}</td><td>${c.refused()}</td></tr>
        </j:forEach>
      </tbody>
    </table>
  </div>
</j:jelly>
